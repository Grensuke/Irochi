# ==================================================
# Irochi — Environment Variables
# ==================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==================================================

# --------------------------------------------------
# Backend (FastAPI)
# --------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_ENV=development
SECRET_KEY=change-me-in-production

# --------------------------------------------------
# PostgreSQL
# Note: If running the backend directly on the host (outside Docker),
# use POSTGRES_HOST=localhost
# --------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=irochi
POSTGRES_USER=irochi
POSTGRES_PASSWORD=change-me

# --------------------------------------------------
# Redis
# Note: If running the backend directly on the host (outside Docker),
# use REDIS_HOST=localhost
# --------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --------------------------------------------------
# Redpanda
# Note: If running the backend directly on the host (outside Docker),
# use REDPANDA_BROKER=localhost:19092
# (19092 is the external port mapped in docker-compose.yml)
# --------------------------------------------------
REDPANDA_BROKER=redpanda:9092

# --------------------------------------------------
# Frontend
# --------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
