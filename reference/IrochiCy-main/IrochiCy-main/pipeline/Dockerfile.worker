FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Fetch SSLBL JA3 blacklist on startup, then start feature worker
CMD ["sh", "-c", \
     "python -c \"import asyncio; from intel.sslbl import sslbl_feed; asyncio.run(sslbl_feed.ensure_loaded())\" && python -m features.worker"]
