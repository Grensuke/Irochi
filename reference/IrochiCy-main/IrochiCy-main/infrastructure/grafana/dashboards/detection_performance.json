    },
    {
      "id": 7,
      "title": "Detector Status — TLS/C2",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 8 },
      "targets": [{ "expr": "pipeline_detector_status{threat_type=\"tls_c2\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "1": { "text": "RUNNING", "color": "green" }, "0": { "text": "IDLE", "color": "yellow" } } }] } }
    },
    {
      "id": 8,
      "title": "Detector Status — Exfil",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 8 },
      "targets": [{ "expr": "pipeline_detector_status{threat_type=\"exfiltration\"}", "refId": "A" }],
