    },
    {
      "id": 9,
      "title": "Total Detections Today",
      "type": "stat",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (threat_type) (increase(alerts_created_total[24h]))",
          "legendFormat": "{{threat_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "options": { "orientation": "horizontal", "textMode": "value_and_name" }
    }
