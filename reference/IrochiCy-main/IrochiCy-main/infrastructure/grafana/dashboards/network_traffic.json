{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "id": 1,
      "title": "Connection Events/sec (15m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(pipeline_events_total{event_type=\"connection\"}[1m])",
          "legendFormat": "connections/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "#3274D9" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "id": 2,
      "title": "Protocol Distribution",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (protocol) (increase(pipeline_events_total{event_type=\"connection\"}[1h]))",
          "legendFormat": "{{protocol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "tcp" }, "properties": [{ "id": "color", "value": { "fixedColor": "#3274D9", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "udp" }, "properties": [{ "id": "color", "value": { "fixedColor": "#56A64B", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "icmp" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 3,
      "title": "Top 10 Source IPs by Event Volume (1h)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "topk(10, sum by (src_ip) (increase(pipeline_events_total[1h])))",
          "legendFormat": "{{src_ip}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "options": { "orientation": "horizontal" }
    },
    {
      "id": 4,
      "title": "Zeek conn_state Distribution",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (conn_state) (increase(zeek_conn_state_total[1h]))",
          "legendFormat": "{{conn_state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "SF" }, "properties": [{ "id": "color", "value": { "fixedColor": "#56A64B", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "S0" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF4444", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "REJ" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 5,
      "title": "DNS Query Volume vs Alert Rate (1h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(pipeline_events_total{event_type=\"dns\"}[1m])",
          "legendFormat": "DNS queries/sec",
          "refId": "A"
        },
        {
          "expr": "rate(alerts_created_total{threat_type=\"dns_dga\"}[1m]) * 60",
          "legendFormat": "DGA alerts/min",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "DGA alerts/min" }, "properties": [{ "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 6,
      "title": "TLS Connection Ratio",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(increase(pipeline_events_total{event_type=\"tls\"}[1h]))",
          "legendFormat": "Encrypted (TLS)",
          "refId": "A"
        },
        {
          "expr": "sum(increase(pipeline_events_total{event_type=\"connection\"}[1h])) - sum(increase(pipeline_events_total{event_type=\"tls\"}[1h]))",
          "legendFormat": "Plaintext",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Encrypted (TLS)" }, "properties": [{ "id": "color", "value": { "fixedColor": "#56A64B", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Plaintext" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }] }
        ]
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["sih26145", "network"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SIH26145 \u2014 Network Traffic Analysis",
  "uid": "sih26145-network-traffic",
  "version": 1
}
